# ============================================================
# Configuracion del BACKEND (API REST) - Barberia Reservas
# ============================================================

# Puerto donde corre la API
PUERTO=4000

# Base de datos MongoDB (nombre: barberia)
MONGO_URI=mongodb://127.0.0.1:27017/barberia

# Seguridad (JWT + hash de contrasenas)
JWT_SECRET=clave-secreta-barberia-sena-2026
JWT_EXPIRA=12h

# Origenes autorizados: frontend web y aplicacion movil
ORIGENES_CORS=http://localhost:5173,http://localhost:5174
